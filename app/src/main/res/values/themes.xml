<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ToolShear" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/toolshear_window_background</item>
    </style>

    <style name="Theme.ToolShear.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/toolshear_seed</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.ToolShear</item>
    </style>
</resources>
